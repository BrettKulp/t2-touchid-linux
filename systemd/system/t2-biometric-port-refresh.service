[Unit]
Description=Discover the current Apple T2 BiometricKit BridgeXPC port
Requires=t2-bridge-network.service
Wants=network-online.target
After=t2-bridge-network.service network-online.target
Before=t2-keybag-load.service t2-biometric-ready.service
ConditionPathExists=/etc/t2-touchid.conf

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/t2-biometric-port-refresh
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
